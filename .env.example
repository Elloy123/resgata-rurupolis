SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Credenciais do Mercado Pago (obtidas em https://www.mercadopago.com.br/developers/panel)
# Use as credenciais de TESTE enquanto estiver desenvolvendo.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# URL base pública do site, usada para montar os links de retorno e webhook do Mercado Pago
# (em desenvolvimento local o Mercado Pago não consegue chamar o webhook em localhost;
# use um túnel como ngrok, ou teste o fluxo em produção/homologação)
SITE_URL=http://127.0.0.1:8000

# Em produção (DEBUG=False), informe o domínio com https para os formulários funcionarem
# Ex: CSRF_TRUSTED_ORIGINS=https://resgatarurupolis.org.br
CSRF_TRUSTED_ORIGINS=
